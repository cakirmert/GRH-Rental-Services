# Copy this file to .env.test.local (ignored by Git).
# Use a disposable local database; never paste a production database URL here.
GRH_TEST_DATABASE_URL=postgresql://postgres:replace-local-password@127.0.0.1:55432/grh_local?sslmode=disable

# Generate once, then keep the same test-only value for build, start and e2e:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GRH_TEST_AUTH_SECRET=

# Optional public, read-only image CDN for a restored catalog (HTTPS origin only).
# This allows existing images to load; uploads remain disabled.
# GRH_TEST_IMAGE_ORIGIN=https://your-public-images.example.com

# Check configuration: node scripts/local-site.mjs check
# Build/start: node scripts/local-site.mjs build, then node scripts/local-site.mjs start
# Development: node scripts/local-site.mjs dev
# Tests: node scripts/local-site.mjs test or node scripts/local-site.mjs e2e
# E2E tests require the local website to be running on http://localhost:3100.
# No production credentials are required; outbound integrations are disabled.
# Request a normal email sign-in code and read [local-otp] in the server terminal.
# Production-domain passkeys do not work on localhost; enroll a separate local one.
