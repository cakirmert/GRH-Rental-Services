# Deployment variable reference. Keep real values in ignored files or secret settings.
# For guarded local development use .env.test.example and the README instead.

# Auth.js Configuration
AUTH_URL=http://localhost:3000
AUTH_SECRET=your_auth_secret_here
# Use a separate random value; keep the live AUTH_SECRET unchanged during upgrades.
CRON_SECRET=your_separate_cron_secret_here

# Database
DATABASE_URL=your_postgres_database_url_here

# Email: contact recipient and VAPID contact remain separate from the sender.
CONTACT_EMAIL=contact@example.com
SMTP_HOST=smtp.example.com
# 465 uses TLS immediately; 587 requires STARTTLS.
SMTP_PORT=465
EMAIL_PASSWORD=your_email_app_password_here
# Optional: each defaults to CONTACT_EMAIL when omitted.
# SMTP_USER=your_smtp_login
# EMAIL_FROM=info@example.com
# EMAIL_REPLY_TO=contact@example.com
# Set EMAIL_REPLY_TO="" to omit the reply-to header for automated emails.

# Vercel Blob Storage Configuration
BLOB_URL_BASE=https://your_blob_url_base_here
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Push Notifications (VAPID keys)
VAPID_PRIVATE_KEY=your_vapid_private_key_here
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# WebAuthn/Passkey Configuration
RP_ID=localhost
RP_NAME=GRH Rental Services
ORIGIN=http://localhost:3000
# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Set true for local/isolated testing to disable mail, push, uploads and scheduled jobs.
DISABLE_OUTBOUND=true

# Protected previews that reuse the production RP ID must allow sign-in only.
# Prevents preview enrollment from replacing a real authenticator credential.
GRH_PASSKEY_SIGNIN_ONLY=false

# Public issue reports. Server-only fine-grained token: this repository, Issues: read and write.
# Never use NEXT_PUBLIC_ names. Delivery also requires a production Vercel runtime.
# Reports remain locally queued while either setting is absent.
GITHUB_REPORTS_ENABLED=false
GITHUB_ISSUES_TOKEN=
